generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js (Prisma adapter) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  currency      String    @default("ZAR")
  payday        Int       @default(25) // 1–31, clamped to month length
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  bankAccounts BankAccount[]
  debts        Debt[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Clearday ----------

model BankAccount {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  debts  Debt[]
  months BankMonth[]

  @@index([userId])
}

enum DebtType {
  CREDIT_CARD
  PERSONAL_LOAN
  CAR
  HOME
  STORE
  STUDENT
  OTHER
}

model Debt {
  id            String    @id @default(cuid())
  userId        String
  bankAccountId String
  name          String
  type          DebtType  @default(OTHER)
  interestRate  Decimal?  @db.Decimal(5, 2) // annual %, optional
  dueDay        Int? // 1–31
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  entries     MonthEntry[]

  @@index([userId])
}

// One row per debt per pay cycle. cycle = "YYYY-MM": payday in that month → day before next payday.
model MonthEntry {
  id          String  @id @default(cuid())
  debtId      String
  cycle       String
  balance     Decimal @db.Decimal(12, 2)
  installment Decimal @db.Decimal(12, 2)
  paid        Boolean @default(false)

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([debtId, cycle])
}

// Salary paid into a bank account for one cycle.
model BankMonth {
  id            String  @id @default(cuid())
  bankAccountId String
  cycle         String
  salary        Decimal @default(0) @db.Decimal(12, 2)

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, cycle])
}
