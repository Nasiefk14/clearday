# Copy to .env and fill in. Never commit .env.

# Local: docker compose up -d
DATABASE_URL="postgresql://clearday:clearday@localhost:5434/clearday"
TEST_DATABASE_URL="postgresql://clearday:clearday@localhost:5435/clearday_test"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated Google emails allowed in. Everyone else lands on the waitlist.
ALLOWED_EMAILS=""
